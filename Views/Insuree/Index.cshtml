@model IEnumerable<CarInsurance.Models.Insuree>
@{ ViewBag.Title = "Insurees"; }
<h2>Insurees</h2>
<p>@Html.ActionLink("Create New", "Create", null, new { @class = "btn" })</p>
<table>
    <tr><th>First Name</th><th>Last Name</th><th>Email</th><th>Date of Birth</th><th>Car</th><th>Quote / month</th><th>Actions</th></tr>
@foreach (var item in Model) {
    <tr>
        <td>@item.FirstName</td><td>@item.LastName</td><td>@item.EmailAddress</td>
        <td>@item.DateOfBirth.ToString("g")</td><td>@item.CarYear @item.CarMake @item.CarModel</td>
        <td>@item.Quote.ToString("C")</td>
        <td>@Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.Id })</td>
    </tr>
}
</table>
