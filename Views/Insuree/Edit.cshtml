@model CarInsurance.Models.Insuree
@{ ViewBag.Title = "Edit Insuree"; }
<h2>Edit Insuree</h2>
@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.ValidationSummary(true, "", new { @class = "error" })
    <label>First name</label>@Html.TextBoxFor(m => m.FirstName)@Html.ValidationMessageFor(m => m.FirstName)
    <label>Last name</label>@Html.TextBoxFor(m => m.LastName)@Html.ValidationMessageFor(m => m.LastName)
    <label>Email address</label>@Html.TextBoxFor(m => m.EmailAddress, new { type = "email" })@Html.ValidationMessageFor(m => m.EmailAddress)
    <label>Date of birth</label>@Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date" })@Html.ValidationMessageFor(m => m.DateOfBirth)
    <label>Car year</label>@Html.TextBoxFor(m => m.CarYear, new { type = "number" })@Html.ValidationMessageFor(m => m.CarYear)
    <label>Car make</label>@Html.TextBoxFor(m => m.CarMake)@Html.ValidationMessageFor(m => m.CarMake)
    <label>Car model</label>@Html.TextBoxFor(m => m.CarModel)@Html.ValidationMessageFor(m => m.CarModel)
    <label>@Html.CheckBoxFor(m => m.DUI) Has the driver ever had a DUI?</label>
    <label>Speeding tickets</label>@Html.TextBoxFor(m => m.SpeedingTickets, new { type = "number", min = "0" })@Html.ValidationMessageFor(m => m.SpeedingTickets)
    <label>@Html.CheckBoxFor(m => m.CoverageType) Full coverage?</label>
    <p>Current quote: @Model.Quote.ToString("C"). The quote will be recalculated when saved.</p>
    <button class="btn" type="submit">Save</button>
}
<p>@Html.ActionLink("Back to List", "Index")</p>
