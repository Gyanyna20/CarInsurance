@model IEnumerable<CarInsurance.Models.Insuree>
@{ ViewBag.Title = "Admin Quotes"; }
<h2>Admin — Insurance Quotes</h2>
<table>
    <tr><th>First Name</th><th>Last Name</th><th>Email Address</th><th>Monthly Quote</th></tr>
@foreach (var item in Model) {
    <tr><td>@item.FirstName</td><td>@item.LastName</td><td>@item.EmailAddress</td><td>@item.Quote.ToString("C")</td></tr>
}
</table>
<p>@Html.ActionLink("Back to List", "Index")</p>
